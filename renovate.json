{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>nklmilojevic/renovate-config", "helpers:pinGitHubActionDigests"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on monday"]
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "separateMinorPatch": false
    },
    {
      "matchPackageNames": ["kube", "/^kube-/", "k8s-openapi", "deskribe"],
      "groupName": "kubernetes crates",
      "separateMajorMinor": false
    },
    {
      "description": "The workflows publish the release: Action updates are reviewed, never merged automatically.",
      "matchFileNames": [".github/workflows/**"],
      "automerge": false
    }
  ]
}
